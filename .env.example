# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://todo_user:todo_password@localhost:5434/todo_app

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

# AI provider selection: gemini | nvidia
# App starts without a key; AI features stay unavailable until configured.
AI_PROVIDER=gemini
AI_MODEL=
AI_FREE_DAILY_LIMIT=20
AI_RATE_LIMIT_PER_MINUTE=10

# Gemini (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# NVIDIA NIM — OpenAI-compatible hosted API (used when AI_PROVIDER=nvidia)
# Example model: openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI Attachments (Phase H)
# Maximum file size in MB for AI conversation attachments (default: 10)
AI_ATTACHMENT_MAX_SIZE_MB=10
# Maximum characters extracted from a document before truncation (default: 50000)
AI_ATTACHMENT_MAX_TEXT_CHARS=50000
# Directory to store uploaded attachment files for local development (default: .ai-attachments in project root)
AI_ATTACHMENT_STORAGE_DIR=
# JSON body-parser limit for GraphQL endpoint in MB (default: 15).
# Must exceed AI_ATTACHMENT_MAX_SIZE_MB to account for Base64 expansion (~33%) and JSON envelope.
AI_GRAPHQL_BODY_LIMIT_MB=15

# Google Calendar Integration
# 32-byte AES-256 key for encrypting stored OAuth tokens (random hex string)
CALENDAR_TOKEN_ENCRYPTION_KEY=
