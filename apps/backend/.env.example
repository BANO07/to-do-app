# Copy to project root as .env
DATABASE_URL=postgresql://todo_user:todo_password@localhost:5434/todo_app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# AI (optional — app starts without GEMINI_API_KEY)
GEMINI_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_FREE_DAILY_LIMIT=20
AI_RATE_LIMIT_PER_MINUTE=10
